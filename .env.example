# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Embeddings locais; baixar o modelo na primeira execução
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_DIM=384

# Supabase (Project Settings > API). Use a chave service_role SOMENTE no backend.
# Se ficar vazio, o RAG usa um armazenamento vetorial local (data/vetores_locais.json)
# e as sessões não são persistidas.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=

RAG_TOP_K=4
RAG_STORE=auto
